// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSource {
  DEMO
  REFERENCE_UNVERIFIED
}

enum CommunityType {
  ONLINE
  OFFLINE
}

enum CommunityAccessType {
  PUBLIC
  PRIVATE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InterestCategory {
  OLAHRAGA
  TEKNOLOGI
  PENDIDIKAN
  SENI_DAN_HIBURAN
  SOSIAL
  LINGKUNGAN
  BISNIS_DAN_KARIER
  HOBI
  KEAGAMAAN
  LAINNYA
}

enum Area {
  KOTA_YOGYAKARTA
  SLEMAN
  BANTUL
  KULON_PROGO
  GUNUNGKIDUL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              UserProfile?
  memberships          CommunityMembership[]
  organizedCommunities CommunityOrganizer[]
  joinRequests         CommunityJoinRequest[]
  submissions          CommunitySubmission[]
  registrations        EventRegistration[]
  activities           UserActivityHistory[]
}

model UserProfile {
  id              String             @id @default(cuid())
  userId          String             @unique
  name            String?
  phone           String?
  phoneVerifiedAt DateTime?
  domicile        Area?
  interests       InterestCategory[]
  bio             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Community {
  id            String              @id @default(cuid())
  name          String
  description   String
  type          CommunityType
  accessType    CommunityAccessType
  categories    InterestCategory[]
  externalLinks String[]
  dataSource    DataSource          @default(DEMO)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  location     CommunityLocation?
  organizers   CommunityOrganizer[]
  members      CommunityMembership[]
  joinRequests CommunityJoinRequest[]
  submission   CommunitySubmission?
  events       EventCommunity[]

  @@index([type])
  @@index([accessType])
  @@index([categories])
}

model CommunityLocation {
  id          String                                @id @default(cuid())
  communityId String                                @unique
  area        Area?
  // PostGIS geography(Point,4326) stored as Unsupported, queried via raw SQL
  coordinates Unsupported("geography(Point,4326)")?
  addressText String? // General area description, never precise personal address
  isOnline    Boolean                               @default(false)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model CommunityOrganizer {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  addedAt     DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityMembership {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  joinedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityJoinRequest {
  id          String           @id @default(cuid())
  communityId String
  userId      String
  status      SubmissionStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([status])
}

model CommunitySubmission {
  id              String           @id @default(cuid())
  communityId     String           @unique
  userId          String
  status          SubmissionStatus @default(PENDING)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  submitter User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Event {
  id               String                                @id @default(cuid())
  name             String
  description      String
  category         InterestCategory
  startDate        DateTime
  endDate          DateTime?
  startTime        String? // "14:00 WIB" or null if unannounced
  venue            String?
  area             Area?
  coordinates      Unsupported("geography(Point,4326)")?
  organizer        String // Organizer name or external account
  contactInfo      String?
  quota            Int?
  registrationOpen Boolean                               @default(false)
  fee              String? // "Gratis", "Rp 50.000", etc.
  externalLink     String?
  dataSource       DataSource                            @default(DEMO)
  isPublished      Boolean                               @default(true)
  createdBy        String? // userId of admin who created it
  publishedAt      DateTime?
  createdAt        DateTime                              @default(now())
  updatedAt        DateTime                              @updatedAt

  relatedCommunities EventCommunity[]
  registrations      EventRegistration[]
  attendance         EventAttendance[]

  @@index([startDate])
  @@index([category])
  @@index([isPublished])
}

model EventCommunity {
  id          String @id @default(cuid())
  eventId     String
  communityId String

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([eventId, communityId])
  @@index([communityId])
}

model EventRegistration {
  id           String    @id @default(cuid())
  eventId      String
  userId       String
  registeredAt DateTime  @default(now())
  cancelledAt  DateTime?

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance EventAttendance?

  @@unique([eventId, userId])
  @@index([userId])
}

model EventAttendance {
  id             String    @id @default(cuid())
  registrationId String    @unique
  attended       Boolean   @default(false)
  markedAt       DateTime?
  markedBy       String? // userId of admin

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event?            @relation(fields: [eventId], references: [id])
  eventId      String?
}

model UserActivityHistory {
  id         String   @id @default(cuid())
  userId     String
  action     String // "view_community", "join_community", "register_event", "search"
  targetType String? // "community", "event"
  targetId   String?
  metadata   Json? // Additional context
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
