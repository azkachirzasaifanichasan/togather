generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Community {
  id                   String                 @id
  name                 String
  description          String
  type                 CommunityType
  accessType           CommunityAccessType
  categories           InterestCategory[]
  externalLinks        String[]
  dataSource           DataSource             @default(DEMO)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  CommunityJoinRequest CommunityJoinRequest[]
  CommunityLocation    CommunityLocation?
  CommunityMembership  CommunityMembership[]
  CommunityOrganizer   CommunityOrganizer[]
  CommunitySubmission  CommunitySubmission?
  EventCommunity       EventCommunity[]

  @@index([accessType])
  @@index([categories])
  @@index([type])
}

model CommunityJoinRequest {
  id          String           @id
  communityId String
  userId      String
  status      SubmissionStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  Community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([status])
  @@index([userId])
}

model CommunityLocation {
  id          String                    @id
  communityId String                    @unique
  area        Area?
  coordinates Unsupported("geography")?
  addressText String?
  isOnline    Boolean                   @default(false)
  Community   Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model CommunityMembership {
  id          String    @id
  communityId String
  userId      String
  joinedAt    DateTime  @default(now())
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityOrganizer {
  id          String    @id
  communityId String
  userId      String
  addedAt     DateTime  @default(now())
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunitySubmission {
  id              String           @id
  communityId     String           @unique
  userId          String
  status          SubmissionStatus @default(PENDING)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  Community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Event {
  id                String                    @id
  name              String
  description       String
  category          InterestCategory
  startDate         DateTime
  endDate           DateTime?
  startTime         String?
  venue             String?
  area              Area?
  coordinates       Unsupported("geography")?
  organizer         String
  contactInfo       String?
  quota             Int?
  registrationOpen  Boolean                   @default(false)
  fee               String?
  externalLink      String?
  dataSource        DataSource                @default(DEMO)
  isPublished       Boolean                   @default(true)
  createdBy         String?
  publishedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime
  EventAttendance   EventAttendance[]
  EventCommunity    EventCommunity[]
  EventRegistration EventRegistration[]

  @@index([category])
  @@index([isPublished])
  @@index([startDate])
  @@index([category], map: "idx_event_category")
  @@index([isPublished], map: "idx_event_published")
  @@index([startDate], map: "idx_event_start_date")
}

model EventAttendance {
  id                String            @id
  registrationId    String            @unique
  attended          Boolean           @default(false)
  markedAt          DateTime?
  markedBy          String?
  eventId           String?
  Event             Event?            @relation(fields: [eventId], references: [id])
  EventRegistration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model EventCommunity {
  id          String    @id
  eventId     String
  communityId String
  Community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  Event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, communityId])
  @@index([communityId])
}

model EventRegistration {
  id              String           @id
  eventId         String
  userId          String
  registeredAt    DateTime         @default(now())
  cancelledAt     DateTime?
  EventAttendance EventAttendance?
  Event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model User {
  id                   String                 @id
  email                String                 @unique
  passwordHash         String
  isAdmin              Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Account              Account[]
  CommunityJoinRequest CommunityJoinRequest[]
  CommunityMembership  CommunityMembership[]
  CommunityOrganizer   CommunityOrganizer[]
  CommunitySubmission  CommunitySubmission[]
  EventRegistration    EventRegistration[]
  UserActivityHistory  UserActivityHistory[]
  UserProfile          UserProfile?
}

model UserActivityHistory {
  id         String   @id
  userId     String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model UserProfile {
  id              String             @id
  userId          String             @unique
  name            String?
  phone           String?
  phoneVerifiedAt DateTime?
  domicile        Area?
  interests       InterestCategory[]
  bio             String?
  address         String?
  avatarUrl       String?
  User            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Area {
  KOTA_YOGYAKARTA
  SLEMAN
  BANTUL
  KULON_PROGO
  GUNUNGKIDUL
}

enum CommunityAccessType {
  PUBLIC
  PRIVATE
}

enum CommunityType {
  ONLINE
  OFFLINE
}

enum DataSource {
  DEMO
  REFERENCE_UNVERIFIED
}

enum InterestCategory {
  OLAHRAGA
  TEKNOLOGI
  PENDIDIKAN
  SENI_DAN_HIBURAN
  SOSIAL
  LINGKUNGAN
  BISNIS_DAN_KARIER
  HOBI
  KEAGAMAAN
  LAINNYA
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
