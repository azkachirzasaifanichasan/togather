# Database Connection
# PostgreSQL with PostGIS extension required
DATABASE_URL="postgresql://username:password@localhost:5432/togather?schema=public"

# NextAuth Configuration
# Generate a secret key with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Seed Configuration (Optional)
# Password untuk demo accounts saat seeding
SEED_DEMO_PASSWORD="demo123456"

# OAuth Providers (Optional - untuk future implementation)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# DISCORD_CLIENT_ID="your-discord-client-id"
# DISCORD_CLIENT_SECRET="your-discord-client-secret"
