# Database Connection
# PostgreSQL with PostGIS extension required
DATABASE_URL="postgresql://username:password@localhost:5432/togather?schema=public"

# NextAuth Configuration
# Generate a secret key with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional)
# Create the credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# When these are not set, the Google provider is not registered and the app
# still works with the email/password provider only.
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Seed Configuration (Optional)
# Password untuk demo accounts saat seeding
SEED_DEMO_PASSWORD="demo123456"

# OAuth Providers (Optional - untuk future implementation)
# DISCORD_CLIENT_ID="your-discord-client-id"
# DISCORD_CLIENT_SECRET="your-discord-client-secret"
