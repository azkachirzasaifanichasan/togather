{
  "name": "togather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
